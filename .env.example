# Django settings
# SECRET_KEY is REQUIRED when DEBUG=False (the app refuses to start without it).
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
# Option A — single URL (recommended for cloud, e.g. Neon):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# Option B — individual vars (local development fallback):
DB_NAME=jokesfor
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432

# Google OAuth (create credentials at console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5173/auth/google/callback

# Site (allauth)
SITE_DOMAIN=localhost:8000
SITE_NAME="JokesFor (dev)"

# Production-only (Cloud Run, etc.) — leave empty for local dev
# Comma-separated lists; appended to the localhost defaults
CORS_ALLOWED_ORIGINS=
# CSRF trusted origins, e.g. https://jokesfor-xyz.run.app,https://app.jokesfor.com
CSRF_TRUSTED_ORIGINS=
# Set to "None" if frontend lives on a different eTLD+1 than the API
JWT_COOKIE_SAMESITE=Lax

# Transport security (production — override for staged HSTS rollout)
# SECURE_HSTS_SECONDS defaults to 31536000 (1 year) when DEBUG=False.
# Start lower (e.g. 3600) on first prod deploy, then ramp up before
# submitting the domain to the browser HSTS preload list.
# SECURE_HSTS_SECONDS=3600

# Error monitoring (optional) — leave SENTRY_DSN empty to disable entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ENVIRONMENT=development

# Media storage (durable uploads + generated share cards).
# Leave GS_BUCKET_NAME EMPTY for local dev/tests -> files go to ./media.
# In production (Cloud Run) set it to the public, uniform-access GCS bucket;
# credentials come from the attached service account (Application Default
# Credentials) -- no key file needed. GOOGLE_APPLICATION_CREDENTIALS is only
# for pointing at a local key file during manual prod-like testing.
GS_BUCKET_NAME=
GS_PROJECT_ID=
# GS_LOCATION sets the GCS bucket region (optional; only for non-default-region buckets).
# GS_LOCATION=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
