# Django settings
# SECRET_KEY is REQUIRED when DEBUG=False (the app refuses to start without it).
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
# Option A — single URL (recommended for cloud, e.g. Neon):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# Option B — individual vars (local development fallback):
DB_NAME=jokesfor
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432

# Google OAuth (create credentials at console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5173/auth/google/callback

# Site (allauth)
SITE_DOMAIN=localhost:8000
SITE_NAME="JokesFor (dev)"

# Production-only (Cloud Run, etc.) — leave empty for local dev
# Comma-separated lists; appended to the localhost defaults
CORS_ALLOWED_ORIGINS=
# CSRF trusted origins, e.g. https://jokesfor-xyz.run.app,https://app.jokesfor.com
CSRF_TRUSTED_ORIGINS=
# Set to "None" if frontend lives on a different eTLD+1 than the API
JWT_COOKIE_SAMESITE=Lax

# Transport security (production — override for staged HSTS rollout)
# SECURE_HSTS_SECONDS defaults to 31536000 (1 year) when DEBUG=False.
# Start lower (e.g. 3600) on first prod deploy, then ramp up before
# submitting the domain to the browser HSTS preload list.
# SECURE_HSTS_SECONDS=3600

# Error monitoring (optional) — leave SENTRY_DSN empty to disable entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ENVIRONMENT=development

# Structured logging / observability.
# On Cloud Run, GOOGLE_CLOUD_PROJECT and K_REVISION are injected automatically
# — you only need to set them here for local prod-like testing.
# LOG_FORMAT defaults to 'plain' when DEBUG=True, 'json' when DEBUG=False.
# LOG_LEVEL defaults to DEBUG locally, INFO in production.
LOG_LEVEL=INFO
# LOG_FORMAT=json
LOG_SQL=false
# GOOGLE_CLOUD_PROJECT=332865216810

# Media storage (durable uploads + generated share cards).
# Leave GS_BUCKET_NAME EMPTY for local dev/tests -> files go to ./media.
# In production (Cloud Run) set it to the public, uniform-access GCS bucket;
# credentials come from the attached service account (Application Default
# Credentials) -- no key file needed. GOOGLE_APPLICATION_CREDENTIALS is only
# for pointing at a local key file during manual prod-like testing.
GS_BUCKET_NAME=
GS_PROJECT_ID=
# GS_LOCATION is an optional subdirectory PREFIX inside the bucket (e.g. media/);
# leave empty to store at the bucket root. The bucket's REGION is chosen at
# creation time (gcloud storage buckets create --location=...), not here.
# GS_LOCATION=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Stripe / billing (leave empty = dormant; billing disabled until keys are set)
# Get test keys from https://dashboard.stripe.com/test/apikeys
# Use sk_test_ locally, sk_live_ in production
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook secret — unique per endpoint/environment (start with whsec_)
STRIPE_WEBHOOK_SECRET=
# BILLING_ENABLED=false — flip to true when pricing is ready
BILLING_ENABLED=false
# Redirect URLs (update for production domain)
BILLING_SUCCESS_URL=http://localhost:5173/billing/success
BILLING_CANCEL_URL=http://localhost:5173/billing/cancel
BILLING_PORTAL_RETURN_URL=http://localhost:5173/account
