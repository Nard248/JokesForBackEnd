# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment files (keep .env.example)
# Match EVERY .env variant, not just the three known suffixes: an
# .env.bak.<timestamp> backup sitting in the tree was invisible to the old
# rules and would have been published by `git add -A` on a public repo.
.env
.env.*
!.env.example

